{
  "author": "LiuRabt",
  "name": "自选股票助手 - 实时查看股票行情",
  "description": "自选股票助手，实时查看您关注的股票及日、周、月、年行情",
  "version": null,
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "http://rabt.gitee.io/funds/docs/dist/index.html",
  "action": {
    "default_icon": {
      "19": "icons/icon19.png",
      "38": "icons/icon38.png"
