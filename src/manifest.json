    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.eastmoney.com/*",
    "https://x2rr.github.io/*"
  ],
  "permissions": [
    "storage",
    "contextMenus"
  ]
}
